{
  "name": "@corekiosk/telemetry-worker",
  "version": "0.2.2",
  "private": true,
  "description": "Serverless Cloudflare Worker + D1 SQLite telemetry & form-sync backend for corekiosk",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply corekiosk-telemetry --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply corekiosk-telemetry --local",
    "db:migrate:remote": "wrangler d1 migrations apply corekiosk-telemetry --remote",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test dist-test/test/worker.test.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/node": "^22.13.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.4.0"
  }
}
